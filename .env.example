# ConvoPilot environment configuration
# Copy to .env.local and fill in. Never commit real values.

# ---- Supabase ----
# Project URL and publishable (anon) key. Public by design; RLS enforces access.
# Local values: `npx supabase status` after `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service-role key is NOT an application variable. It is used only by the isolated
# privileged runner and must never be present in the Next.js runtime (docs/SECURITY.md §4).

# ---- AI provider (decision P3: Anthropic; server-only) ----
# Secret: set only in Vercel / a local .env.local, never commit it. Without it, AI features
# show "AI isn't connected yet".
ANTHROPIC_API_KEY=
# Optional. Default claude-opus-5-5.
AI_MODEL=
# Optional. Per-workspace daily AI spending cap in USD. Default 1.
AI_DAILY_COST_CAP_USD=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
