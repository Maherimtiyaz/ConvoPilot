# ConvoPilot environment configuration
# Copy to .env.local and fill in. Never commit real values.

# ---- Supabase ----
# Project URL and publishable (anon) key. Public by design; RLS enforces access.
# Local values: `npx supabase status` after `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service-role key is NOT an application variable. It is used only by the isolated
# privileged runner and must never be present in the Next.js runtime (docs/SECURITY.md §4).

# ---- AI provider (provider-agnostic) ----
# AI_PROVIDER: openai-compatible | anthropic | gemini | ollama
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_EMBEDDING_MODEL=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
