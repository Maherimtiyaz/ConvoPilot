# ConvoPilot environment configuration
# Copy to .env.local and fill in. Never commit real values.

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI provider (provider-agnostic) ----
# AI_PROVIDER: openai-compatible | anthropic | gemini | ollama
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_EMBEDDING_MODEL=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
