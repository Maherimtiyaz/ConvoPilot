{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "ConvoPilot brand tokens v1.0. Source of truth for docs/BRAND.md section 9.",
  "color": {
    "ink":        { "900": { "$value": "#0E1B2C" }, "700": { "$value": "#2B3A4E" }, "500": { "$value": "#5B6B80" }, "300": { "$value": "#C5CDD8" }, "200": { "$value": "#DDE3EA" }, "100": { "$value": "#EDF0F4" }, "50": { "$value": "#F3F5F7" } },
    "marker":     { "500": { "$value": "#FFD23F" }, "100": { "$value": "#FFF1B8" } },
    "route":      { "600": { "$value": "#2450D3" }, "300": { "$value": "#8FB0FF" }, "50": { "$value": "#E8EEFC" } },
    "white":      { "$value": "#FFFFFF" },
    "success":    { "$value": "#0F7B4A" },
    "warning":    { "$value": "#9A5B00" },
    "error":      { "$value": "#B42318" }
  },
  "theme": {
    "light": {
      "bg":            { "$value": "{color.ink.50}" },
      "surface":       { "$value": "{color.white}" },
      "surface-muted": { "$value": "{color.ink.100}" },
      "border":        { "$value": "{color.ink.200}" },
      "border-strong": { "$value": "{color.ink.300}" },
      "text":          { "$value": "{color.ink.900}" },
      "text-muted":    { "$value": "{color.ink.500}" },
      "link":          { "$value": "{color.route.600}" },
      "action-bg":     { "$value": "{color.ink.900}" },
      "action-text":   { "$value": "{color.white}" },
      "highlight":     { "$value": "{color.marker.500}" },
      "highlight-soft":{ "$value": "{color.marker.100}" },
      "focus":         { "$value": "{color.route.600}" }
    },
    "dark": {
      "bg":            { "$value": "{color.ink.900}" },
      "surface":       { "$value": "#16263B" },
      "surface-muted": { "$value": "#1E3049" },
      "border":        { "$value": "{color.ink.700}" },
      "border-strong": { "$value": "{color.ink.500}" },
      "text":          { "$value": "{color.ink.50}" },
      "text-muted":    { "$value": "#A7B4C4" },
      "link":          { "$value": "{color.route.300}" },
      "action-bg":     { "$value": "{color.marker.500}" },
      "action-text":   { "$value": "{color.ink.900}" },
      "highlight":     { "$value": "{color.marker.500}" },
      "highlight-soft":{ "$value": "#3A3520" },
      "focus":         { "$value": "{color.route.300}" }
    }
  },
  "font": {
    "family": {
      "display": { "$value": "Newsreader, 'Source Serif 4', Georgia, serif" },
      "sans":    { "$value": "'Instrument Sans', Inter, system-ui, sans-serif" },
      "mono":    { "$value": "'IBM Plex Mono', 'JetBrains Mono', ui-monospace, monospace" }
    },
    "weight": { "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 } },
    "size": {
      "caption": { "$value": "12px" }, "small": { "$value": "14px" }, "body": { "$value": "16px" },
      "lead": { "$value": "20px" }, "h4": { "$value": "20px" }, "h3": { "$value": "25px" },
      "h2": { "$value": "31px" }, "h1": { "$value": "49px" }, "display": { "$value": "76px" }
    },
    "lineHeight": { "tight": { "$value": 1.05 }, "heading": { "$value": 1.2 }, "body": { "$value": 1.5 } },
    "tracking": { "display": { "$value": "-0.02em" }, "heading": { "$value": "-0.01em" }, "body": { "$value": "0" }, "label": { "$value": "0.06em" } }
  },
  "space":  { "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" }, "4": { "$value": "16px" }, "6": { "$value": "24px" }, "8": { "$value": "32px" }, "12": { "$value": "48px" }, "16": { "$value": "64px" }, "24": { "$value": "96px" }, "32": { "$value": "128px" } },
  "radius": { "xs": { "$value": "2px" }, "sm": { "$value": "6px" }, "md": { "$value": "10px" }, "lg": { "$value": "16px" }, "pill": { "$value": "999px" } },
  "shadow": {
    "1": { "$value": "0 1px 2px rgba(14,27,44,0.06)" },
    "2": { "$value": "0 4px 12px rgba(14,27,44,0.08)" },
    "3": { "$value": "0 12px 32px rgba(14,27,44,0.12)" }
  },
  "angle": { "lean": { "$value": "20deg", "$description": "Brand lean: chisel ends and quote tails. tan = 0.36" } },
  "grid": { "columns": { "$value": 12 }, "gutter": { "$value": "24px" }, "container": { "$value": "1200px" }, "margin": { "desktop": { "$value": "80px" }, "tablet": { "$value": "32px" }, "phone": { "$value": "16px" } } }
}
